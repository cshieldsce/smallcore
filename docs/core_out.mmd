%%{init: {"flowchart": {"wrappingWidth": 360}}}%%
%% Core, part 2 of 3: from the TX FIFO to the pins. Blue = register, yellow = combinational, grey = from
%% or to another diagram. gpio has three write ports; no two write on the same edge: SHIFT_OUT's side
%% pin is never 0, and an ACC word has no side effect.
flowchart LR
  classDef reg fill:#dbe8ff,stroke:#4a6fa5
  classDef comb fill:#fff4d6,stroke:#c49a2a
  classDef ext fill:#f0f0f0,stroke:#888

  TXIN(["tx_data[7:0], tx_push"]):::ext
  DEC(["decode<br/>(core_fetch)"]):::ext
  ACC(["acc[15]<br/>(core_in)"]):::ext
  OUT(["gpio_out[3:0], gpio_oe[3:0]<br/>(uio_out, uio_oe)"]):::ext
  TOIN(["shift_dir, shift_reg<br/>to core_in"]):::ext

  subgraph core["core: output"]
    direction LR
    FIFO["<b>tx_fifo</b><br/>8 bits × depth<br/>tx_push → append<br/>pull_en → drop head"]:::reg
    SD["<b>shift_dir</b> reg, 1 bit<br/>rst → 0 (LSB first)<br/>cfg_en & field 0 → own[0]"]:::reg
    SR["<b>shift_reg</b> reg, 8 bits<br/>rst → 0<br/>pull_en → fifo_head<br/>shift_en → shift toward the wire end<br/>shift_bit = shift_dir ? [7] : [0]"]:::reg
    OD["<b>open_drain</b> reg, 4 bits<br/>rst → 0 (push-pull)<br/>cfg_en & field 1 → [1:0] ← own[1:0]<br/>cfg_en & field 2 → [3:2] ← own[1:0]"]:::reg
    PIN["<b>gpio</b> reg, 4 bits<br/>rst → 4'b1111<br/>shift_en → gpio[0] ← shift_bit<br/>gpio_en → gpio[side_pin] ← side_val<br/>acc_en & ACC_OUT → gpio[acc_pin] ← acc[15]<br/>gpio_oe = ~(open_drain & gpio)"]:::reg

    FIFO -->|"fifo_head[7:0]"| SR
    SD -->|"shift_dir"| SR
    SR -->|"shift_bit"| PIN
    OD -->|"open_drain[3:0]"| PIN
  end

  TXIN --> FIFO
  DEC -->|"own"| SD
  DEC -->|"own"| OD
  DEC -->|"side_pin, side_val"| PIN
  ACC --> PIN
  PIN --> OUT
  SR --> TOIN

  style core fill:#f6f8fb,stroke:#9aa7b8
