%% What the control block does each cycle. Not a separate state register:
%% each state is read off counter, pc, tx_empty, rx_full and gpio_in.
stateDiagram-v2
  direction LR
  [*] --> Issue

  Issue : Issue (counter == 0)
  Issue : run imem[pc], counter ← delay
  Issue : last cycle: pc ← JMP ? target : pc + 1

  Hold : Hold (counter > 0)
  Hold : counter ← counter − 1

  Stall : Stall (PULL, TX FIFO empty / PUSH, RX FIFO full /<br/>WAIT, pin not at the level)
  Stall : everything holds, side effect waits too

  Halt : Halt (pc == N)
  Halt : pins keep their levels

  Issue --> Hold : delay > 0
  Hold --> Issue : counter == 1
  Issue --> Stall : FIFO empty / full,<br/>pin not at the level
  Stall --> Issue : byte arrived / room /<br/>the level
  Issue --> Halt : last instruction<br/>finished
  Hold --> Halt : last instruction<br/>finished
