%%{init: {"flowchart": {"wrappingWidth": 320}}}%%
%% Datapath at Verilog level. Blue = register (one always @(posedge clk)), yellow = combinational.
%% Only data wires are drawn. The enables named inside each register (pull_en, shift_en,
%% gpio_en, gpio_sel, pc_en, pc_jmp) come from the control block, see control.svg.
flowchart LR
  classDef reg fill:#dbe8ff,stroke:#4a6fa5
  classDef comb fill:#fff4d6,stroke:#c49a2a
  classDef ext fill:#f0f0f0,stroke:#888

  TXIN(["tx_data[7:0], tx_push"]):::ext

  subgraph core["core"]
    direction LR
    PC["<b>pc</b> reg, 8 bits<br/>rst → 0<br/>pc_en → pc_jmp ? operand : pc + 1"]:::reg
    IMEM["<b>imem</b> ROM<br/>N × 16 bits<br/>word = imem[pc]"]:::comb
    DEC["<b>decode</b><br/>opcode = word[15:13]<br/>delay = word[12:8]<br/>operand = word[7:0]"]:::comb
    FIFO["<b>tx_fifo</b><br/>8 bits × depth<br/>tx_push → append<br/>pull_en → drop head"]:::reg
    SR["<b>shift_reg</b> reg, 8 bits<br/>rst → 0<br/>pull_en → fifo_head<br/>shift_en → {1'b0, shift_reg[7:1]}"]:::reg
    PIN["<b>gpio</b> reg, 4 bits<br/>rst → 4'b1111<br/>gpio_en → gpio[idx] ← bit<br/>bit = gpio_sel ? shift_reg[0] : operand[0]<br/>idx = gpio_sel ? 0 : operand[5:4]"]:::reg

    PC -->|"pc"| IMEM
    IMEM -->|"word[15:0]"| DEC
    DEC -->|"operand[5:4], operand[0]"| PIN
    DEC -->|"operand[7:0]"| PC
    FIFO -->|"fifo_head[7:0]"| SR
    SR -->|"shift_reg[0]"| PIN
  end

  TXIN --> FIFO
  PIN -->|"gpio[3:0]"| OUT(["gpio out"]):::ext

  style core fill:#f6f8fb,stroke:#9aa7b8
