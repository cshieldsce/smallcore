%%{init: {"flowchart": {"wrappingWidth": 320}}}%%
%% Datapath at Verilog level. Blue = register (one always @(posedge clk)), yellow = combinational.
%% Only data wires are drawn. The enables named inside each register (pull_en, shift_en,
%% gpio_en, dir_en, pc_en, pc_jmp) come from the control block, see control.svg. gpio has two
%% write ports: SHIFT_OUT writes gpio[0], SET and the SHIFT_OUT side effect write the operand
%% pin. shift_dir selects which end of shift_reg feeds gpio[0] and which way it shifts.
flowchart LR
  classDef reg fill:#dbe8ff,stroke:#4a6fa5
  classDef comb fill:#fff4d6,stroke:#c49a2a
  classDef ext fill:#f0f0f0,stroke:#888

  TXIN(["tx_data[7:0], tx_push"]):::ext

  subgraph core["core"]
    direction LR
    PC["<b>pc</b> reg, 8 bits<br/>rst → 0<br/>pc_en → pc_jmp ? operand : pc + 1"]:::reg
    IMEM["<b>imem</b> ROM<br/>N × 16 bits<br/>word = imem[pc]"]:::comb
    DEC["<b>decode</b><br/>opcode = word[15:13]<br/>delay = word[12:8]<br/>operand = word[7:0]"]:::comb
    FIFO["<b>tx_fifo</b><br/>8 bits × depth<br/>tx_push → append<br/>pull_en → drop head"]:::reg
    SD["<b>shift_dir</b> reg, 1 bit<br/>rst → 0 (LSB first)<br/>dir_en → operand[0]"]:::reg
    SR["<b>shift_reg</b> reg, 8 bits<br/>rst → 0<br/>pull_en → fifo_head<br/>shift_en → shift_dir ?<br/>{shift_reg[6:0], 1'b0} : {1'b0, shift_reg[7:1]}<br/>shift_bit = shift_dir ?<br/>shift_reg[7] : shift_reg[0]"]:::reg
    PIN["<b>gpio</b> reg, 4 bits<br/>rst → 4'b1111<br/>shift_en → gpio[0] ← shift_bit<br/>gpio_en → gpio[pin] ← operand[0]<br/>pin = operand[5:4]<br/>(a side effect fires both:<br/>its pin is never 0)"]:::reg

    PC -->|"pc"| IMEM
    IMEM -->|"word[15:0]"| DEC
    DEC -->|"operand[5:4], operand[0]"| PIN
    DEC -->|"operand[7:0]"| PC
    DEC -->|"operand[0]"| SD
    SD -->|"shift_dir"| SR
    FIFO -->|"fifo_head[7:0]"| SR
    SR -->|"shift_bit"| PIN
  end

  TXIN --> FIFO
  PIN -->|"gpio[3:0]"| OUT(["gpio out"]):::ext

  style core fill:#f6f8fb,stroke:#9aa7b8
