%%{init: {"flowchart": {"wrappingWidth": 440}}}%%
%% The control block: what it reads, what it computes, what it drives. All combinational
%% except the counter register. Signal names match core.svg. The opcode names stand for
%% opcode == that value: NOP/SET = 000, SHIFT = 001, FIFO = 010, JMP = 011, CONFIG = 100, WAIT = 101,
%% SKIP = 110.
flowchart LR
  classDef sig fill:#f0f0f0,stroke:#888
  classDef reg fill:#dbe8ff,stroke:#4a6fa5
  classDef comb fill:#fff4d6,stroke:#c49a2a

  OPC(["opcode"]):::sig
  DLY(["delay"]):::sig
  PCV(["pc"]):::sig
  EMP(["tx_empty"]):::sig
  FUL(["rx_full"]):::sig
  GIN(["gpio_in[3:0]"]):::sig
  ISR(["in_shift_reg[7:0]"]):::sig
  SIDE(["side = operand[7]"]):::sig
  OWN(["own = operand[3:0]<br/>in = own[1], push = own[0], field = own[3:2]<br/>in_pin = own[3:2], bit = own[3:1], level = own[0]"]):::sig

  CU["<b>control</b><br/><br/>cycles = 1 + delay<br/>halted = pc == N<br/>issue = !halted & counter == 0<br/>stall = issue & (FIFO & (push ? rx_full : tx_empty)<br/>| WAIT & gpio_in[in_pin] != level)<br/>last = issue ? delay == 0 : counter == 1<br/>skip = SKIP & in_shift_reg[bit] == level<br/><br/><b>counter</b> reg, 5 bits, rst → 0<br/>issue & !stall → delay<br/>counter > 0 → counter − 1"]:::comb

  PCI(["pc_en = last & !stall"]):::sig
  PCJ(["pc_jmp = JMP"]):::sig
  PCS(["pc_skip = skip<br/>(pc + 1 + pc_skip: over the next word)"]):::sig
  PLE(["pull_en = issue & FIFO & !push & !tx_empty"]):::sig
  PSE(["push_en = issue & FIFO & push & !rx_full"]):::sig
  SHE(["shift_en = issue & SHIFT & !in"]):::sig
  SIE(["shift_in_en = issue & SHIFT & in"]):::sig
  PNE(["gpio_en = issue & !stall & side & !JMP<br/>(one pin-write port: SET and every side effect)"]):::sig
  DIE(["cfg_en = issue & CONFIG<br/>(field 0 = shift_dir, 1 = open_drain[1:0], 2 = open_drain[3:2])"]):::sig

  OPC --> CU
  DLY --> CU
  PCV --> CU
  EMP --> CU
  FUL --> CU
  GIN --> CU
  ISR --> CU
  SIDE --> CU
  OWN --> CU
  CU --> PCI
  CU --> PCJ
  CU --> PCS
  CU --> PLE
  CU --> PSE
  CU --> SHE
  CU --> SIE
  CU --> PNE
  CU --> DIE
