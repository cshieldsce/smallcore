%%{init: {"flowchart": {"wrappingWidth": 260}}}%%
flowchart LR
  W["16-bit word<br/>at PC"] --> OP{"opcode<br/>[15:13]"}
  OP -->|010| PULL["<b>PULL [d]</b><br/>shift_reg ← FIFO head<br/>pins unchanged<br/>takes 1 + d cycles<br/>after any stall"]
  PULL -->|"TX FIFO empty: stall,<br/>everything holds"| PULL
  OP -->|000| SET["<b>SET p, v [d]</b><br/>gpio[p] ← v<br/>other pins unchanged<br/>takes 1 + d cycles"]
  OP -->|001| SHIFT["<b>SHIFT_OUT [p, v] [d]</b><br/>gpio[0] ← next bit, then shift:<br/>shift_dir 0: shift_reg[0], >> 1<br/>shift_dir 1: shift_reg[7], << 1<br/>with p, v: gpio[p] ← v<br/>(one edge, then hold)<br/>takes 1 + d cycles"]
  OP -->|011| JMP["<b>JMP target [d]</b><br/>pins, shift registers unchanged<br/>takes 1 + d cycles"]
  OP -->|100| CFG["<b>CONFIG_SHIFT r [d]</b><br/>shift_dir ← r<br/>pins, shift registers unchanged<br/>takes 1 + d cycles"]
  OP -->|101| SHIN["<b>SHIFT_IN i [p, v] [d]</b><br/>bit = gpio_in[i] at cycle start<br/>shift_dir 0: >> 1, then [7] ← bit<br/>shift_dir 1: << 1, then [0] ← bit<br/>(of in_shift_reg)<br/>with p, v: gpio[p] ← v<br/>(one edge, then hold)<br/>takes 1 + d cycles"]
  PULL --> NEXT["PC ← PC + 1"]
  SET --> NEXT
  SHIFT --> NEXT
  CFG --> NEXT
  SHIN --> NEXT
  JMP --> JNEXT["PC ← target"]
  NEXT --> END{"PC past last<br/>instruction?"}
  JNEXT --> END
  END -->|no| W
  END -->|yes| HALT(["halt<br/>pins keep their levels"])
